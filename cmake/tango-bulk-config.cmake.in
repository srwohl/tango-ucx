@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads REQUIRED)
find_dependency(ucx 1.21 CONFIG REQUIRED)
find_dependency(nlohmann_json 3.12 CONFIG REQUIRED)
find_dependency(Tango CONFIG REQUIRED)
include("${CMAKE_CURRENT_LIST_DIR}/tango-bulk-targets.cmake")
check_required_components(tango-bulk)
