@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(ucx 1.21 CONFIG)
find_dependency(nlohmann_json 3.12 CONFIG)
find_dependency(Tango CONFIG)
if(@TANGO_UCX_CUDA@)
    find_dependency(CUDAToolkit)
endif()
find_library(UCX_UCM_LIBRARY NAMES ucm HINTS "${ucx_DIR}/../.." REQUIRED)
if(NOT TARGET tango-ucx::ucm) # UCX's package has no target for libucm
    add_library(tango-ucx::ucm UNKNOWN IMPORTED)
    set_target_properties(tango-ucx::ucm PROPERTIES IMPORTED_LOCATION "${UCX_UCM_LIBRARY}")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/tango-ucx-targets.cmake")
check_required_components(tango-ucx)
